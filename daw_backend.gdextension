[configuration]

entry_symbol = "daw_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/daw_backend.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/daw_backend.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/daw_backend.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/daw_backend.linux.template_release.x86_64.so"
macos.debug = "res://bin/daw_backend.macos.template_debug.framework"
macos.release = "res://bin/daw_backend.macos.template_release.framework"
